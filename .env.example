# Copy this file to ".env" and fill in YOUR values. Never commit ".env".
APP_ENV=development

# PostgreSQL connection. Your database teammate gives you these details.
# The database must already be created with docs/skillloop_database.sql.
DATABASE_URL=postgresql+psycopg://skillloop_user:CHANGE_ME@localhost:5432/skillloop

# Long random string used to sign login tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Origins allowed to call the API from the browser (React dev server).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional API hardening
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
MAX_PROFILE_IMAGE_BYTES=5242880

# Failed login attempts per account (in addition to the per-IP auth limit)
LOGIN_ACCOUNT_RATE_LIMIT_ATTEMPTS=5
LOGIN_ACCOUNT_RATE_LIMIT_WINDOW_SECONDS=900
